{
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": "conventionalcommits"
    }
  },
  "hooks": {
    "after:bump": "node sync-version.js",
    "before:git:beforeRelease": "node clean-changelog.js"
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "npm": { "publish": false }
}
